# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Expo public mirrors
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_BOOKING_SERVICE_URL=http://localhost:3002
EXPO_PUBLIC_MATCHING_SERVICE_URL=http://localhost:8001
EXPO_PUBLIC_PAYMENT_SERVICE_URL=http://localhost:3003
EXPO_PUBLIC_NOTIFICATION_SERVICE_URL=http://localhost:3005
EXPO_PUBLIC_SAFETY_SERVICE_URL=http://localhost:3006
VITE_SAFETY_SERVICE_URL=http://localhost:3006
EXPO_PUBLIC_RAZORPAY_KEY_ID=
EXPO_PUBLIC_EAS_PROJECT_ID=

# Node services
BOOKING_SERVICE_PORT=3002
PAYMENT_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3005
SAFETY_SERVICE_PORT=3006
MATCHING_SERVICE_URL=http://localhost:8001
PAYMENT_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3005

# Shared secret the booking/payment/safety services attach as x-internal-secret
# when calling the notification service's /push, /sms, /whatsapp/booking, /sos
# routes. Required in production (notification refuses to boot without it there)
# so those routes can't be used as an open SMS/push relay. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_SECRET=

# Comma-separated list of origins allowed to call the Node services directly
# from a browser (the console and frontend web apps). Mobile isn't subject to
# CORS so this never affects it. Leave unset in local dev -- REQUIRED in
# production (each Node service refuses to boot without it there; unset means
# any origin can call it).
CORS_ORIGIN=

# 2Factor.in (alternate OTP SMS route, used by loginOtp.service.ts alongside
# Fast2SMS/MSG91)
TWOFACTOR_API_KEY=

# Python matching service
MATCHING_SERVICE_PORT=8001
# One key is enough: booking, matching, Expo maps, and admin embed all read this.
# Enable Maps SDK (Android/iOS), Directions, Geocoding, Places, and Maps Embed.
GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# HyperVerge KYC (Aadhaar + DL + face match). If left unset, booking's
# kyc.service.ts falls back to pending_review (upload-only, no automated
# verification) instead of failing.
HYPERVERGE_APP_ID=
HYPERVERGE_APP_KEY=

# Cloudflare R2 (KYC document + profile photo storage). Required in production —
# booking's env.ts refuses to boot without these once NODE_ENV=production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# MSG91 SMS
MSG91_AUTH_KEY=
MSG91_SENDER_ID=RDSHAR

# Fast2SMS (DLT-free OTP route — used for login OTP delivery today, no DLT/business registration needed)
FAST2SMS_API_KEY=

# Gupshup WhatsApp
GUPSHUP_API_KEY=
GUPSHUP_SOURCE_NUMBER=
# Meta-approved "Authentication" template's Gupshup template ID, used for OTP delivery over WhatsApp
GUPSHUP_OTP_TEMPLATE_ID=

# Centrifugo (in-app chat). config.json ships with token_hmac_secret_key/api_key
# blank and centrifugo overlays them from CENTRIFUGO_API_KEY /
# CENTRIFUGO_TOKEN_HMAC_SECRET (docker-compose maps the latter to Centrifugo's
# own CENTRIFUGO_TOKEN_HMAC_SECRET_KEY var name) — generate real random values
# for these, the same way as INTERNAL_SERVICE_SECRET above, and never reuse the
# placeholder values that used to be committed in config.json.
CENTRIFUGO_API_URL=http://localhost:8010
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_HMAC_SECRET=
EXPO_PUBLIC_CENTRIFUGO_WS_URL=ws://localhost:8010/connection/websocket
VITE_CENTRIFUGO_WS_URL=ws://localhost:8010/connection/websocket
