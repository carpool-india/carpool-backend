{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BOOKING_SERVICE_URL": "http://192.168.1.7:3002",
        "EXPO_PUBLIC_MATCHING_SERVICE_URL": "http://192.168.1.7:8001",
        "EXPO_PUBLIC_PAYMENT_SERVICE_URL": "http://192.168.1.7:3003",
        "EXPO_PUBLIC_NOTIFICATION_SERVICE_URL": "http://192.168.1.7:3005",
        "EXPO_PUBLIC_SAFETY_SERVICE_URL": "http://192.168.1.7:3006",
        "EXPO_PUBLIC_CENTRIFUGO_WS_URL": "ws://192.168.1.7:8010/connection/websocket"
      },
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BOOKING_SERVICE_URL": "https://rideshare-booking.onrender.com",
        "EXPO_PUBLIC_MATCHING_SERVICE_URL": "https://rideshare-matching.onrender.com",
        "EXPO_PUBLIC_PAYMENT_SERVICE_URL": "https://rideshare-payment.onrender.com",
        "EXPO_PUBLIC_NOTIFICATION_SERVICE_URL": "https://rideshare-notification.onrender.com",
        "EXPO_PUBLIC_SAFETY_SERVICE_URL": "https://rideshare-safety.onrender.com",
        "EXPO_PUBLIC_CENTRIFUGO_WS_URL": "wss://rideshare-centrifugo.onrender.com/connection/websocket"
      },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BOOKING_SERVICE_URL": "https://rideshare-booking.onrender.com",
        "EXPO_PUBLIC_MATCHING_SERVICE_URL": "https://rideshare-matching.onrender.com",
        "EXPO_PUBLIC_PAYMENT_SERVICE_URL": "https://rideshare-payment.onrender.com",
        "EXPO_PUBLIC_NOTIFICATION_SERVICE_URL": "https://rideshare-notification.onrender.com",
        "EXPO_PUBLIC_SAFETY_SERVICE_URL": "https://rideshare-safety.onrender.com",
        "EXPO_PUBLIC_CENTRIFUGO_WS_URL": "wss://rideshare-centrifugo.onrender.com/connection/websocket"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
